{
  "name": "worker-pro-refactor",
  "version": "12.0.0",
  "description": "Worker 智能中控 — Cloudflare 多账号 Worker 部署管理平台",
  "scripts": {
    "build": "node build.js",
    "build:cloudflare": "node build.js",
    "dev": "wrangler dev --port 7890",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verify": "node verify.js",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node test/smoke.js",
    "check": "node build.js && tsc --noEmit && node verify.js && vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.99.0",
    "@cloudflare/workers-types": "^5.20260731.1",
    "sweetalert2": "11.14.5"
  }
}
